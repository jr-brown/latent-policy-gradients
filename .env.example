# Project-local environment for rl-generalisation.
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# Variables here are loaded into `os.environ` at the top of main.py via
# python-dotenv, BEFORE any other imports, so they're visible to
# research_scaffold, jax, wandb, etc.

# wandb entity/project that analysis pipelines fetch runs from.
# Format: "<entity>/<project>"  (entity = your wandb username or team).
# Required unless every analysis config sets `offline: true` (uses only the
# local cache at local/cache/).
WANDB_PATH=youruser/yourproject

# Optional: a project-scoped wandb API key. If unset, wandb falls back to
# its global config (~/.netrc or `wandb login`). Leave commented out unless
# you specifically want a per-project key.
# WANDB_API_KEY=
